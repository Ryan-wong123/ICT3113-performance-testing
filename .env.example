# Ollama runs locally on the host. Docker Desktop resolves host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Choose one locally pulled candidate model when benchmarking begins.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=300

# Assignment 2 only. Keep false for the unchanged Assignment 1/single-model path.
CASCADE_ENABLED=false
# Fill these from the pinned Assignment 1 candidates after the tuning-set decision.
OLLAMA_SMALL_MODEL=
OLLAMA_LARGE_MODEL=
CASCADE_RULE_SETTING=
# Supported code-frozen strategies: category, length, category_or_length, always, never.
CASCADE_RULE_TYPE=category
# Separate exact category names with |. Leave empty until the rule is frozen.
CASCADE_ESCALATE_CATEGORIES=
CASCADE_LENGTH_THRESHOLD_CHARS=

